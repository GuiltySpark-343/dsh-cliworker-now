+// @vitest-environment jsdom
+// Explicit simulated external CLI receipts rendered by the real native components.
+import { afterEach, describe, expect, it } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { StatsPills } from '../src/client/chat/StatsPills.tsx'
+import { TurnUsagePanel } from '../src/client/chat/TurnUsagePanel.tsx'
+import { TurnTailNodeView } from '../src/client/chat/TurnTailNodeView.tsx'
+import { externalCacheRatio, externalUsageReport, type ExternalUsageReport } from '../src/client/contract/external-usage.ts'
+import { resolveExternalTurnUsage, type ExternalTurnUsage } from '../src/client/contract/external-turn-usage.ts'
+import { zh } from '../src/client/locale.ts'
+
+afterEach(cleanup)
+const t = makeTranslate(zh, commonZh)
+const native = { uncachedInputTokens: 12, outputTokens: 8, cacheReadTokens: 20, cacheWriteTokens: 3, totalTokens: 43 }
+const partial: ExternalUsageReport = { totalTokens: 3901, inputBasis: 'inclusive', inputTokens: 3897, outputTokens: 4 }
+function stats(externalUsage: unknown, metadata = {}) {
+  const props: any = { t, usePerformanceUsage: (selector: (value: string) => unknown) => selector('detailed'),
+    useChat: (selector: (value: any) => unknown) => selector({ legacy: { nodes: [] } }),
+    useProjection: (key: string) => key === 'tokenUsage' ? { ...native, externalUsage, ...metadata } : undefined,
+  }
+  return render(<StatsPills {...props} />)
+}
+
+describe('optional external partial accounting in native components', () => {
+  it('renders an actual total and known input/output while omitting unknown cache and hit rows', () => {
+    const view = stats(partial, { externalScope: 'run', externalRunId: 'synthetic-run' })
+    const trigger = view.getByRole('button')
+    expect(trigger.textContent).toContain('3.9K tok')
+    expect(trigger.textContent).not.toContain('命中')
