+afterEach(cleanup)
+const t = makeTranslate(zh, commonZh)
+const pending = { state: 'pending', reason: 'awaiting-data' }
+const unavailable = { state: 'unavailable', reason: 'not-reported' }
+function stats(values: Record<string, unknown> = {}, mode = 'detailed') {
+  const props: any = { t, usePerformanceUsage: (s: (x: string) => unknown) => s(mode),
+    useChat: (s: (x: unknown) => unknown) => s({ legacy: { nodes: [] } }),
+    useProjection: (key: string) => values[key] }
+  return render(<StatsPills {...props} />)
