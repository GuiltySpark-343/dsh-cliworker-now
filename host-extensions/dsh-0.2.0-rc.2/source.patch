@@ -0,0 +1,42 @@
+// Synthetic released-format native events reproducing the old CLI bridge.
+import { ConversationNodeAssembler } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { SessionLiveEventEntry } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { ChatSnapshot } from '../src/client/contract/snapshot.ts'
+import { assistantDefinition } from '../src/client/conversation-nodes/assistant.ts'
+import { nextStepInboxDefinition, nextTurnInboxDefinition } from '../src/client/conversation-nodes/inbox.ts'
+import { toolDefinition } from '../src/client/conversation-nodes/tool.ts'
+import { messageDefinition } from '../src/client/conversation-nodes/message.ts'
+import { turnProcessDefinition } from '../src/client/conversation-nodes/turn-process.ts'
+import { turnTailDefinition } from '../src/client/conversation-nodes/turn-tail.ts'
+import { unknownFallbackDefinition } from '../src/client/conversation-nodes/fallback.ts'
+import { chatViewDefinition } from '../src/client/conversation-nodes/chat-snapshot-builder.ts'
+export const proof = { answerSeq: 4, answerStep: 1, messageId: 'synthetic-answer', turnEndSeq: 14 }
+const row = (seq: number, type: string, data: unknown, surfaceOp?: string) => ({ type: 'event', event: {
+  seq, type, time: seq * 1000, data, ...(surfaceOp ? { surfaceOp } : {}),
+} }) as SessionLiveEventEntry
+export function recoveryEntries(): SessionLiveEventEntry[] {
+  return [row(1, 'turn/start', { turn: 1 }), row(2, 'step/start', { turn: 1, step: 1 }),
+    row(3, 'user/message', { id: 'synthetic-human', source: { kind: 'user' }, content: [{ type: 'text', text: 'Synthetic prompt' }] }, 'append'),
+    row(4, 'assistant/message', { turn: 1, step: 1, message: { id: 'synthetic-answer', source: { provider: 'synthetic', model: 'synthetic' }, content: [{ type: 'text', text: 'Synthetic hello' }] }, stream: [] }, 'append'),
+    row(5, 'step/end', { turn: 1, step: 1 }), row(6, 'step/start', { turn: 1, step: 2 }),
+    row(7, 'user/message', { id: 'synthetic-continuation-1', source: { kind: 'cliworker-continuation' }, content: [] }, 'append'),
+    row(8, 'assistant/message', { turn: 1, step: 2, message: { id: 'synthetic-reasoning', source: { provider: 'synthetic', model: 'synthetic' }, content: [{ type: 'reasoning', text: 'Synthetic preserved reasoning' }] }, stream: [] }, 'append'),
+    row(9, 'step/end', { turn: 1, step: 2 }), row(10, 'step/start', { turn: 1, step: 3 }),
+    row(11, 'user/message', { id: 'synthetic-continuation-2', source: { kind: 'cliworker-continuation' }, content: [] }, 'append'),
+    row(12, 'assistant/message', { turn: 1, step: 3, message: { id: 'synthetic-empty', source: { provider: 'synthetic', model: 'synthetic' }, content: [] }, stream: [] }, 'append'),
+    row(13, 'step/end', { turn: 1, step: 3 }), row(14, 'turn/end', { turn: 1, reason: { kind: 'completed' } })]
+}
+export function recoverySnapshot(entries = recoveryEntries()): ChatSnapshot {
+  const assembler = new ConversationNodeAssembler({ entries: () => [nextStepInboxDefinition, nextTurnInboxDefinition, messageDefinition, assistantDefinition, turnProcessDefinition, turnTailDefinition, toolDefinition],
+    fallbackEntry: () => unknownFallbackDefinition }, { entries: () => [chatViewDefinition] })
+  assembler.replaceWindow(entries, false)
+  assembler.activateTarget('chat')
+  return assembler.snapshot('chat') as ChatSnapshot
+}
+
+export function sameStepLateReasoningSnapshot() {
+  const entries = recoveryEntries().slice(0, 5)
+  ;(entries[3]!.event as any).data.message.content.push({ type: 'reasoning', text: 'Synthetic same-step late reasoning' })
+  entries.push({ type: 'event', event: { type: 'turn/end', seq: 6, time: 6000, data: { turn: 1, reason: { kind: 'completed' } } } } as any)
+  return recoverySnapshot(entries)
+}
