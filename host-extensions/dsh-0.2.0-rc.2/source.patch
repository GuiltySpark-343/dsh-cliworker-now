@@ -0,0 +1,46 @@
+// @vitest-environment jsdom
+// Synthetic explicit availability snapshots; no context/token estimates.
+import { afterEach, expect, it } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { ContextMeter } from '../src/client/skeleton/ContextMeter.tsx'
+import { zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+const t = makeTranslate(zh, commonZh)
+const pending = { context: { state: 'pending', reason: 'awaiting-data' } }
+function meter(values: Record<string, unknown>) {
+  return render(<ContextMeter t={t} useProjection={((key: string) => values[key]) as any} />)
+}
+it('retains an unknown native context module until both fields arrive, without showing 0%', () => {
+  const view = meter({ telemetryAvailability: pending, contextPressure: { contextWindow: 128000 } })
+  fireEvent.click(view.getByRole('button', { name: '上下文 —' }))
+  expect(view.getByRole('dialog').textContent).toContain('等待已确认的上下文占用及容量')
+  expect(view.getByRole('dialog').textContent).not.toContain('0%')
+  expect(view.container.querySelector('[stroke-dasharray]')).toBeNull()
+  fireEvent.keyDown(document, { key: 'Escape' })
+  expect(view.queryByRole('dialog')).toBeNull()
+})
+it.each(['not-reported', 'disconnected'])('explains actual unavailable reason %s', reason => {
+  const view = meter({ telemetryAvailability: { context: { state: 'unavailable', reason } } })
+  fireEvent.click(view.getByRole('button', { name: '上下文 —' }))
+  expect(view.getByRole('dialog').textContent).toContain(reason === 'disconnected' ? '数据连接已断开' : '当前 CLI 尚未公开')
+})
+it('prefers actual occupancy over optional availability, including a real zero reading', () => {
+  const view = meter({ telemetryAvailability: pending, contextPressure: { pressureTokens: 0, contextWindow: 128000 } })
+  expect(view.getByRole('button', { name: '上下文已用 0%' })).toBeTruthy()
+  expect(view.container.textContent).not.toContain('—')
+})
+it('does not opt in the normal native view on missing or malformed availability', () => {
+  expect(meter({}).container.textContent).toBe('')
+  expect(meter({ telemetryAvailability: { context: { state: 'pending', reason: 'guess' } } }).container.textContent).toBe('')
+})
+it('updates the same native module from unknown to actual occupancy', () => {
+  const view = meter({ telemetryAvailability: pending })
+  expect(view.getByRole('button', { name: '上下文 —' })).toBeTruthy()
+  const values = { telemetryAvailability: pending, contextPressure: { pressureTokens: 32000, contextWindow: 128000 } }
+  view.rerender(<ContextMeter t={t} useProjection={((key: string) => (values as any)[key]) as any} />)
+  expect(view.getByRole('button', { name: '上下文已用 25%' })).toBeTruthy()
+  expect(view.queryByRole('button', { name: '上下文 —' })).toBeNull()
+})
