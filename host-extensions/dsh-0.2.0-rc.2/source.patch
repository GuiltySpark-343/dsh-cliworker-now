+import { expect, it } from 'vitest'
+import { externalTurnAnswerEntries, externalTurnProcessPresentation, resolveExternalTurnAnswer, resolveExternalTurnAnswers } from '../src/client/contract/external-turn-answer.ts'
+import { proof, recoveryEntries, recoverySnapshot } from './external-turn-answer-fixture.ts'
+
+it('recovers the exact existing answer while preserving all original nodes and events', () => {
+  const entries = recoveryEntries()
+  const before = JSON.stringify(entries)
+  const snapshot = recoverySnapshot(entries)
+  expect(snapshot.timeline.turns.get(1)?.data.get('turn-process')?.answerStep).toBeNull()
+  const resolved = resolveExternalTurnAnswer(snapshot, 1, proof)!
+  expect(resolved.spec.answerStep).toBe(1)
+  expect(resolved.spec.answerAnchorSeq).toBe(4)
+  expect(resolved.answer.blocks).toEqual([{ kind: 'text', text: 'Synthetic hello' }])
+  expect(resolved.hasExternalProcess).toBe(true)
+  expect(snapshot.timeline.turns.get(1)?.data.get('turn-process')?.answerStep).toBeNull()
+  expect(JSON.stringify(entries)).toBe(before)
+})
+it.each([
+  { ...proof, answerSeq: 8 }, { ...proof, answerStep: 2 }, { ...proof, messageId: 'foreign' },
+  { ...proof, turnEndSeq: 15 }, { ...proof, answerSeq: NaN }, { ...proof, answerStep: -1 },
+])('rejects mismatched or malformed anchors %j', supplied => {
+  expect(resolveExternalTurnAnswer(recoverySnapshot(), 1, supplied)).toBeUndefined()
+})
+it.each(['text', 'tool-call', 'image'])('rejects later new response material %s', type => {
+  const entries = recoveryEntries()
+  const event = entries[7]!.event as any
+  event.data.message.content = [{ type, text: 'new reply', id: 'tool', name: 'tool', arguments: '{}' }]
+  expect(resolveExternalTurnAnswer(recoverySnapshot(entries), 1, proof)).toBeUndefined()
+})
+it.each([
+  { source: { kind: 'user' }, content: [] },
+  { source: { kind: 'cliworker-continuation-other' }, content: [] },
+  { source: { kind: 'cliworker-continuation' }, content: [{ type: 'text', text: 'new input' }] },
+])('rejects later input unless precisely the empty continuation notice %j', input => {
+  const entries = recoveryEntries(); Object.assign((entries[6]!.event as any).data, input)
+  expect(resolveExternalTurnAnswer(recoverySnapshot(entries), 1, proof)).toBeUndefined()
+})
+it('rejects open/failed turns and missing history rather than repairing default DSH', () => {
+  const open = recoveryEntries().slice(0, -1)
+  expect(resolveExternalTurnAnswer(recoverySnapshot(open), 1, proof)).toBeUndefined()
+  const failed = recoveryEntries(); (failed.at(-1)!.event as any).data.reason = { kind: 'error', error: { code: 'SYNTHETIC', message: 'synthetic' } }
+  expect(resolveExternalTurnAnswer(recoverySnapshot(failed), 1, proof)).toBeUndefined()
+  expect(resolveExternalTurnAnswer(recoverySnapshot(recoveryEntries().slice(1)), 1, proof)).toBeUndefined()
+})
+it('only changes the proven turn and preserves default identity without source', () => {
+  const snapshot = recoverySnapshot()
+  const key = snapshot.order.find(key => snapshot.nodes.get(key)?.kind === 'assistant-step')!
+  const original = snapshot.nodes.processSource(key).getSnapshot()
+  expect(externalTurnProcessPresentation(original, resolveExternalTurnAnswers(snapshot, undefined))).toBe(original)
+  expect(resolveExternalTurnAnswers(snapshot, { '01': proof, '2': proof, '0': proof }).size).toBe(0)
+  const resolved = resolveExternalTurnAnswers(snapshot, { '1': proof })
+  expect(externalTurnProcessPresentation(original, resolved)?.spec.answerStep).toBe(1)
+  expect(externalTurnProcessPresentation(original && { ...original, turn: 2 }, resolved)?.spec.answerStep).toBeNull()
+})
+
+it('accepts real empty continuation inbox insert/claim splices', () => {
+  const entries = recoveryEntries()
+  const insertion: any = { type: 'event', event: { type: 'agent/inbox/spliced', data: {
+    target: 'next-step', start: 0, inserted: [{ id: 'synthetic-continuation-1', source: { kind: 'cliworker-continuation' }, content: [] }] } } }
+  const removal: any = { type: 'event', event: { type: 'agent/inbox/spliced', data: {
+    target: 'next-step', start: 0, removedCount: 1, inserted: [] } } }
+  entries.splice(5, 0, insertion)
+  entries.splice(7, 0, removal)
+  entries.forEach((entry, index) => { (entry.event as any).seq = index + 1; (entry.event as any).time = (index + 1) * 1000 })
+  expect(resolveExternalTurnAnswer(recoverySnapshot(entries), 1, { ...proof, turnEndSeq: 16 })?.spec.answerStep).toBe(1)
+})
+it('rejects a later actual Tool node even without an assistant tool-call block', () => {
+  const entries = recoveryEntries()
+  Object.assign(entries[7]!.event, { type: 'tool/call', data: { turn: 1, step: 2, callId: 'synthetic-tool', name: 'read', arguments: '{}' } })
+  expect(resolveExternalTurnAnswer(recoverySnapshot(entries), 1, proof)).toBeUndefined()
+})
+
+it('stably moves only proven native reasoning references before the existing answer', () => {
+  const snapshot = recoverySnapshot()
+  const entries = snapshot.order.map(key => ({ kind: 'node', key })) as any
+  const before = JSON.stringify(entries)
+  const resolved = resolveExternalTurnAnswers(snapshot, { '1': proof })
+  const answer = resolved.get(1)!.answerNodeKey
+  const reason = snapshot.nodes.values().find((node: any) => node.kind === 'assistant-step' && node.data.step === 2)!.key
+  expect(entries.findIndex((entry: any) => entry.key === reason)).toBeGreaterThan(entries.findIndex((entry: any) => entry.key === answer))
+  const ordered = externalTurnAnswerEntries(entries, snapshot, resolved)
+  expect(ordered.findIndex(entry => entry.key === reason)).toBeLessThan(ordered.findIndex(entry => entry.key === answer))
+  expect(ordered.filter(entry => entry.key === answer)).toHaveLength(1)
+  expect(JSON.stringify(entries)).toBe(before)
+  expect(externalTurnAnswerEntries(entries, snapshot, new Map())).toBe(entries)
+})
+it('does not reorder unresolved or mixed-content groups', () => {
+  const snapshot = recoverySnapshot()
+  const resolved = resolveExternalTurnAnswers(snapshot, { '1': proof })
+  const answer = resolved.get(1)!.answerNodeKey
+  const entries = [{ kind: 'node', key: answer, groupPart: 'response' }, { kind: 'group', key: 'unknown-group' }] as any
+  expect(externalTurnAnswerEntries(entries, snapshot, resolved)).toBe(entries)
+  expect(externalTurnAnswerEntries(entries, snapshot, resolved, () => [{ kind: 'node', key: answer, groupPart: 'response' } as any])).toBe(entries)
+})
